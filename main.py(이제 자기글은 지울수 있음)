import hashlib
import hmac
import secrets
import sqlite3
from datetime import datetime
from pathlib import Path
from uuid import uuid4
import pandas as pd
import streamlit as st

# DB 연결 및 테이블 생성
conn = sqlite3.connect("school_community_v4.db", check_same_thread=False)
c = conn.cursor()

# 게시글 테이블
